{
  "name": "web",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @carehe/web dev" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @carehe/web build" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @carehe/web typecheck" }
    }
  }
}
